# DATAFORGE — Environment Configuration

# AI Provider ("gemini" | "ollama" | "heuristic")
AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama Local AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Demo & Synthetic Data Mode ("synthetic" | "live" | "hybrid")
DATA_MODE=synthetic
DEMO_MODE=true

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
